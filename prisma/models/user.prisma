model User {
    id             String        @id @default(uuid())
    name           String
    email          String        @unique
    password       String
    phone          String
    address        String?
    userType       String
    status         String
    lastLogin      DateTime?
    profileImageId String?
    profileImage   FileInstance? @relation(fields: [profileImageId], references: [id])

    owner        Owner?
    activityLogs ActivityLog[]
    adminSetting AdminSetting?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
