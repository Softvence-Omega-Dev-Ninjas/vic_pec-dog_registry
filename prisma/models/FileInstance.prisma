model FileInstance {
    id               String   @id @default(uuid())
    filename         String
    originalFilename String
    path             String
    url              String
    fileType         String
    mimeType         String
    size             Int
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    usersProfileImage User[]     @relation("usersProfileImage")
    ownerCoverImages  Owner[]    @relation("ownerCoverImages")
    dogMediaFiles     DogMedia[]

    @@map("file_instances")
}
